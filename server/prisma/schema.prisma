}

model SetupStep {
  id             Int                 @id @default(autoincrement())
  step_key       String              @unique @db.VarChar(60)
  label          String?             @db.VarChar(150)
  description    String?             @db.VarChar(300)
  category       SetupStepCategory   @default(platform)
  display_order  Int                 @default(0)
  status         SetupStepStatus     @default(pending)
  completed_at   DateTime?
  completed_by   Int?
  config_route   String?             @db.VarChar(200)

  @@map("setup_steps")
}

model UiTranslation {
  id                Int      @id @default(autoincrement())
  translation_key   String   @unique @db.VarChar(120)
  en                String?  @db.Text
  fr                String?  @db.Text
  context           String?  @db.VarChar(200)
  is_reviewed       Boolean  @default(false)
  updated_at        DateTime @updatedAt

  @@map("ui_translations")
}

model FooterLink {
  id             Int      @id @default(autoincrement())
  label          String?  @db.VarChar(100)
  label_fr       String?  @db.VarChar(100)
  url            String?  @db.VarChar(300)
  column_group   String?  @db.VarChar(50)
  display_order  Int      @default(0)
  opens_new_tab  Boolean  @default(false)
  is_active      Boolean  @default(true)
  is_required    Boolean  @default(false)

  @@map("footer_links")
}
