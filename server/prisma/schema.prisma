model BulkImport {
  id                 Int                @id @default(autoincrement())
  import_type        BulkImportType
  target_content_id  Int?
  file_url           String?            @db.VarChar(500)
  total_rows         Int?
  succeeded          Int?
  updated            Int?
  skipped            Int?
  failed             Int?
  status             BulkImportStatus   @default(uploaded)
  error_report_url   String?            @db.VarChar(500)
  created_by         Int?
  created_at         DateTime           @default(now())

  @@map("bulk_imports")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONSENT & POLICIES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Policy {
  id                  Int      @id @default(autoincrement())
  policy_key          String   @db.VarChar(60)
  title               String?  @db.VarChar(200)
  title_fr            String?  @db.VarChar(200)
  body_html           String?  @db.Text
  body_html_fr        String?  @db.Text
  version             Int      @default(1)
  effective_from      DateTime?
  requires_reconsent  Boolean  @default(false)
  is_active           Boolean  @default(true)

  @@unique([policy_key, version])
  @@map("policies")
}

/// NOTE: APPEND-ONLY. Never update or delete — enforced in the service layer.
model ConsentRecord {
  id               Int             @id @default(autoincrement())
  user_id          Int
  policy_key       String?         @db.VarChar(60)
  policy_version   Int?
  /// A withdrawal is a NEW row with granted=false, never an edit or a delete.
  /// Without this column the table can only say "accepted", which makes the
  /// append-only rule unimplementable. Current state for a policy is the newest
  /// row by accepted_at.
  granted          Boolean         @default(true)
  accepted_at      DateTime        @default(now())
  ip_address       String?         @db.VarChar(45)
  user_agent       String?         @db.VarChar(300)
  consent_method   ConsentMethod?

  @@index([user_id, policy_key])
  @@map("consent_records")
}

/// Password-reset and email-verification tokens.
///
/// The token itself is never stored — only a SHA-256 hash of it. A leaked
/// database read otherwise hands over live account-recovery links for every
/// pending reset.
model AuthToken {
  id          Int             @id @default(autoincrement())
  user_id     Int
  token_hash  String          @unique @db.VarChar(64)
  purpose     AuthTokenPurpose
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime        @default(now())

  @@index([user_id])
  @@index([token_hash])
  @@map("auth_tokens")
}

model SignupField {
  id             Int                  @id @default(autoincrement())
  field_key      String?              @db.VarChar(60)
  label          String?              @db.VarChar(100)
  label_fr       String?              @db.VarChar(100)
  field_type     SignupFieldType?
  context        SignupFieldContext?
  is_enabled     Boolean              @default(true)
  is_required    Boolean              @default(false)
  display_order  Int                  @default(0)
  options        String?              @db.Text
  help_text      String?              @db.VarChar(200)

  @@map("signup_fields")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// NOTIFICATIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Notification {
  id          Int      @id @default(autoincrement())
  user_id     Int
  type        String?  @db.VarChar(50)
  title       String?  @db.VarChar(200)
  body        String?  @db.Text
  link_url    String?  @db.VarChar(500)
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([user_id, is_read])
  @@map("notifications")
}

model NotificationPreference {
  id          Int                  @id @default(autoincrement())
  user_id     Int?
  event_key   String               @db.VarChar(60)
  channel     NotificationChannel
  is_enabled  Boolean              @default(true)

  @@unique([user_id, event_key, channel])
  @@map("notification_preferences")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// USER PREFERENCES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model UserPreference {
  id                       Int                @id @default(autoincrement())
  user_id                  Int                @unique
  timezone                 String?            @db.VarChar(64)
  language                 String?            @db.VarChar(10)
  subtitle_language        String?            @db.VarChar(10)
  default_quality          String?            @db.VarChar(10)
  data_saver               Boolean            @default(false)
  default_playback_speed   Decimal            @default(1.0) @db.Decimal(3, 2)
  subtitles_on             Boolean            @default(true)
  autoplay_next            Boolean            @default(true)
  reminder_offsets         String             @default("1440,60,10") @db.VarChar(60)
  calendar_sync_enabled    Boolean            @default(false)
  calendar_provider        CalendarProvider?
  quiet_hours_start        DateTime?          @db.Time
  quiet_hours_end          DateTime?          @db.Time
  weekly_digest            Boolean            @default(true)

  @@map("user_preferences")
}

model UserDevice {
  id                   Int      @id @default(autoincrement())
  user_id              Int?
  device_fingerprint   String?  @db.VarChar(120)
  device_name          String?  @db.VarChar(100)
  device_type          String?  @db.VarChar(20)
  os                   String?  @db.VarChar(60)
  browser              String?  @db.VarChar(60)
  first_seen_at        DateTime @default(now())
  last_seen_at         DateTime @default(now())
  last_ip              String?  @db.VarChar(45)
  last_country          String?  @db.VarChar(2)
  is_active            Boolean  @default(true)

  @@unique([user_id, device_fingerprint])
  @@map("user_devices")
}

/// NOTE: ics_token drives the /calendar/:token.ics download endpoint — a permanent
/// per-user-per-session link that calendar apps poll. Revoke by setting is_active=false.
model CalendarEvent {
  id                  Int               @id @default(autoincrement())
  user_id             Int
  content_id          Int
  provider            CalendarProvider
  provider_event_id   String?           @db.VarChar(200)
  ics_token           String            @unique @default(uuid()) @db.VarChar(64)
  synced_at           DateTime?
  is_active           Boolean           @default(true)

  @@unique([user_id, content_id, provider])
  @@index([ics_token])
  @@map("calendar_events")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HOMEPAGE ENGINE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model ContentRow {
  id                Int          @id @default(autoincrement())
  row_key           String?      @db.VarChar(60)
  label             String?      @db.VarChar(120)
  label_fr          String?      @db.VarChar(120)
  row_type          RowType
  surface           RowSurface?
  platform          RowPlatform  @default(all)
  audience          RowAudience  @default(all)
  params            String?      @db.Text
  card_limit        Int          @default(15)
  display_order     Int          @default(0)
  is_enabled        Boolean      @default(true)
  hide_when_empty   Boolean      @default(true)
  card_style        CardStyle    @default(poster)

  @@map("content_rows")
}

model RowRule {
  id                 Int                @id @default(autoincrement())
  rule_key           String?            @db.VarChar(60)
  description        String             @db.VarChar(200)
  condition_type     RowConditionType?
  condition_value    Int?
  promote_row_key    String?            @db.VarChar(60)
  priority           Int?
  is_enabled         Boolean            @default(true)

  @@map("row_rules")
}

model HomepageCache {
  id             Int      @id @default(autoincrement())
  cache_key      String   @unique @db.VarChar(120)
  payload        String?  @db.Text
  generated_at   DateTime @default(now())
  expires_at     DateTime?
  row_count      Int?
  item_count     Int?

  @@index([cache_key])
  @@index([expires_at])
  @@map("homepage_cache")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CMS & SITE
