model Sponsor {
  id            Int      @id @default(autoincrement())
  name          String?  @db.VarChar(150)
  logo_url      String?  @db.VarChar(500)
  website_url   String?  @db.VarChar(300)
  contact_email String?  @db.VarChar(190)
  is_active     Boolean  @default(true)

