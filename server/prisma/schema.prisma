// WEBINARFLIX — database schema
// Faithful implementation of PROMPT 01-C from the master build prompt.
//
// Deviations from the source spec (documented, all deliberate):
//  - The spec targets NoCodeBackend (a REST-first no-code backend) which never declares
//    foreign-key constraints, only indexed integer columns (e.g. "content_id INT NOT NULL").
//    We keep that shape here: cross-table references are plain indexed Int columns, not
//    Prisma relations. This avoids inventing referential-integrity rules the spec never
//    specified, and keeps the schema a direct, auditable transcription of the prompt.
//  - `created_at` / timestamp-of-creation columns get `@default(now())` even where the
//    spec doesn't print DEFAULT — that's the only sane default for an append-style column.
//  - LONGTEXT (MySQL-ism) maps to Postgres `text`.
//  - Enum values containing characters invalid in a Prisma enum identifier (e.g.
//    'co-instructor') are declared with a safe identifier and mapped back with @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

