// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CORE CONTENT
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique @db.VarChar(190)
  password_hash       String?    @db.VarChar(255)
  full_name           String?    @db.VarChar(150)
  avatar_url          String?    @db.VarChar(500)
  role                UserRole   @default(viewer)
  country             String     @default("NG") @db.VarChar(2)
  timezone            String     @default("Africa/Lagos") @db.VarChar(64)
  preferred_language  String     @default("en") @db.VarChar(10)
  industry            String?    @db.VarChar(80)
  job_role            String?    @db.VarChar(80)
  company_name        String?    @db.VarChar(150)
  headline            String?    @db.VarChar(200)
  bio                 String?    @db.Text
  parent_account_id   Int?
  seat_status         SeatStatus @default(none)
  is_active           Boolean    @default(true)
  email_verified      Boolean    @default(false)
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  @@index([email])
  @@index([role])
  @@index([parent_account_id])
  @@map("users")
}

model ContentItem {
  id                          Int            @id @default(autoincrement())
  content_type                ContentType
  title                       String         @db.VarChar(200)
  title_fr                    String?        @db.VarChar(200)
  slug                        String         @unique @db.VarChar(220)
  short_description           String?        @db.VarChar(250)
  short_description_fr        String?        @db.VarChar(250)
  description_html            String?        @db.Text
  description_html_fr         String?        @db.Text
  master_image_url            String?        @db.VarChar(500)
  focal_x                     Int            @default(50)
  focal_y                     Int            @default(50)
  image_overrides             String?        @db.Text
  status                      ContentStatus  @default(draft)
  scheduled_start_at          DateTime?
  timezone                    String         @default("Africa/Lagos") @db.VarChar(64)
  scheduled_duration_minutes  Int?
  registration_closes_at      DateTime?
  capacity                    Int?
  session_format              SessionFormat?
  language                    String         @default("en") @db.VarChar(10)
  content_rating               String         @default("general") @db.VarChar(20)
  access_level                AccessLevel    @default(registered)
  price_mode                  PriceMode      @default(fixed)
  price_ngn                   Decimal?       @db.Decimal(12, 2)
  suggested_price_ngn         Decimal?       @db.Decimal(12, 2)
  minimum_price_ngn           Decimal?       @db.Decimal(12, 2)
  compare_at_price_ngn        Decimal?       @db.Decimal(12, 2)
  free_preview_seconds        Int            @default(0)
  expires_at                  DateTime?
  expiry_action                ExpiryAction?
  stream_provider              String?        @db.VarChar(50)
  stream_key                  String?        @db.VarChar(255)
  playback_id                 String?        @db.VarChar(255)
  is_cohort                   Boolean        @default(false)
  cohort_start_date           DateTime?      @db.Date
  restream_enabled             Boolean        @default(false)
  restream_cutoff_minutes      Int?
  is_featured                 Boolean        @default(false)
  is_active                   Boolean        @default(true)
  show_in_hero                 Boolean        @default(false)
  has_transcript               Boolean        @default(false)
  has_chapters                 Boolean        @default(false)
  has_substitute                Boolean        @default(false)
  watermark_enabled             Boolean        @default(false)
  avg_rating                  Decimal        @default(0) @db.Decimal(3, 2)
  rating_count                 Int            @default(0)
  view_count                   Int            @default(0)
  registration_count           Int            @default(0)
  search_tags                  String?        @db.VarChar(500)
  seo_title                    String?        @db.VarChar(200)
  seo_meta_description          String?        @db.VarChar(300)
  seo_canonical_url             String?        @db.VarChar(300)
  pre_roll_ad_id                Int?
  mid_roll_ad_id                 Int?
  mid_roll_offset_seconds        Int?
  publish_at                    DateTime?
  content_last_updated_at        DateTime?
  last_reviewed_by                Int?
  created_by                    Int?
  // Course-specific JSON columns (null for non-course content types)
  outcomes_json                 String?        @db.Text
  cert_config_json              String?        @db.Text
  created_at                    DateTime       @default(now())
  updated_at                    DateTime       @updatedAt

  @@index([status])
  @@index([scheduled_start_at])
  @@index([content_type])
  @@index([access_level])
  @@index([is_featured])
  @@index([is_active])
  @@index([status, scheduled_start_at])
  @@index([content_type, status])
  @@map("content_items")
}

model Category {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  name_fr        String?  @db.VarChar(100)
  slug           String?  @unique @db.VarChar(120)
  description    String?  @db.VarChar(300)
  description_fr String?  @db.VarChar(300)
  image_url      String?  @db.VarChar(500)
  show_as_tile   Boolean  @default(false)
  display_order  Int      @default(0)
  is_active      Boolean  @default(true)

  @@map("categories")
}

model ContentCategory {
  id          Int @id @default(autoincrement())
  content_id  Int
  category_id Int

  @@unique([content_id, category_id])
  @@index([content_id])
  @@index([category_id])
  @@map("content_categories")
}

model SpeakerType {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(100)
  name_fr       String? @db.VarChar(100)
  slug          String? @db.VarChar(120)
  display_order Int     @default(0)
  is_active     Boolean @default(true)

  @@map("speaker_types")
}

model Speaker {
  id                       Int      @id @default(autoincrement())
  full_name                String   @db.VarChar(150)
  slug                     String   @unique @db.VarChar(170)
  email                    String?  @db.VarChar(190)
  phone                    String?  @db.VarChar(30)
  title                    String?  @db.VarChar(150)
  organisation             String?  @db.VarChar(150)
  bio                      String?  @db.Text
  bio_fr                   String?  @db.Text
  master_image_url         String?  @db.VarChar(500)
  focal_x                  Int      @default(50)
  focal_y                  Int      @default(50)
  linkedin_url             String?  @db.VarChar(300)
  speaker_type_id          Int?
  user_id                  Int?
  bank_code                String?  @db.VarChar(10)
  bank_name                String?  @db.VarChar(120)
  account_number           String?  @db.VarChar(10)
  account_name_resolved    String?  @db.VarChar(150)
  paystack_recipient_code  String?  @db.VarChar(120)
  payout_verified          Boolean  @default(false)
  commission_pct           Decimal  @default(0) @db.Decimal(5, 2)
  is_active                Boolean  @default(true)
  auto_approve             Boolean  @default(false)
  created_at               DateTime @default(now())

  @@index([user_id])
  @@index([speaker_type_id])
  @@map("speakers")
}

model ContentSpeaker {
  id                  Int                @id @default(autoincrement())
  content_id          Int
  speaker_id          Int
  role                ContentSpeakerRole @default(speaker)
  revenue_share_pct   Decimal            @default(0) @db.Decimal(5, 2)

  @@index([content_id])
  @@index([speaker_id])
  @@map("content_speakers")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MEDIA LIBRARY
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model MediaAsset {
  id                 Int              @id @default(autoincrement())
  title              String?          @db.VarChar(200)
  asset_type         MediaAssetType
  source_type        MediaSourceType  @default(upload)
  provider           String?          @db.VarChar(50)
  provider_asset_id  String?          @db.VarChar(255)
  hls_url            String?          @db.VarChar(500)
  mp4_url            String?          @db.VarChar(500)
  embed_url          String?          @db.VarChar(500)
  thumbnail_url      String?          @db.VarChar(500)
  duration_seconds   Int?
  file_size_mb       Int?
  resolution         String?          @db.VarChar(20)
  transcode_status   TranscodeStatus  @default(pending)
  is_protected       Boolean          @default(true)
  storage_zone       String?          @db.VarChar(100)
  tags               String?          @db.VarChar(500)
  uploaded_by        Int?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  @@index([asset_type])
  @@index([transcode_status])
  @@index([uploaded_by])
  @@index([is_protected])
  @@map("media_assets")
}

model ContentMedia {
  id              Int              @id @default(autoincrement())
  content_id      Int?
  lesson_id       Int?
  media_asset_id  Int
  role            ContentMediaRole @default(main)
  display_order   Int              @default(0)

  @@index([content_id])
  @@index([lesson_id])
  @@index([media_asset_id])
  @@map("content_media")
}

model ImageVariant {
  id                 Int     @id @default(autoincrement())
