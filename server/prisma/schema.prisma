// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Registration {
  id                  Int                 @id @default(autoincrement())
  user_id             Int
  content_id          Int
  registered_at       DateTime            @default(now())
  status              RegistrationStatus  @default(confirmed)
  join_token          String              @unique @default(uuid()) @db.VarChar(64)
  custom_answers      String?             @db.Text
  reminder_24h_sent   Boolean             @default(false)
  reminder_1h_sent    Boolean             @default(false)
  reminder_10m_sent   Boolean             @default(false)

  @@unique([user_id, content_id])
  @@index([content_id])
  @@index([status])
  @@map("registrations")
}

model Attendance {
  id               Int       @id @default(autoincrement())
  registration_id  Int
  joined_at        DateTime?
  left_at          DateTime?
  watch_seconds    Int       @default(0)
  attended         Boolean   @default(false)

  @@index([registration_id])
  @@map("attendance")
}

model QaQuestion {
  id            Int      @id @default(autoincrement())
  content_id    Int
  user_id       Int?
  question      String?  @db.Text
  upvotes       Int      @default(0)
  is_answered   Boolean  @default(false)
  is_anonymous  Boolean  @default(false)
  created_at    DateTime @default(now())

  @@index([content_id])
  @@map("qa_questions")
}

model SessionConfig {
  id                   Int     @id @default(autoincrement())
  content_id           Int     @unique
  chat_enabled         Boolean @default(true)
  qa_enabled           Boolean @default(true)
  polls_enabled        Boolean @default(false)
  chat_moderated       Boolean @default(true)
  allow_anonymous_qa   Boolean @default(true)

  @@map("session_config")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTITLEMENTS & COMMERCE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Plan {
  id                       Int              @id @default(autoincrement())
  name                     String?          @db.VarChar(100)
  price_ngn                Decimal?         @db.Decimal(12, 2)
  billing_interval         BillingInterval  @default(monthly)
  features                 String?          @db.Text
  max_concurrent_streams   Int              @default(1)
  seat_count               Int              @default(1)
  is_team_plan             Boolean          @default(false)
  is_active                Boolean          @default(true)

  @@map("plans")
}

model Subscription {
  id                           Int                 @id @default(autoincrement())
  user_id                      Int
  plan_id                      Int
  status                       SubscriptionStatus  @default(active)
  current_period_end           DateTime?
  paused_until                 DateTime?
  cancelled_at                 DateTime?
  paystack_subscription_code   String?             @db.VarChar(120)
  created_at                   DateTime            @default(now())

  @@index([user_id])
  @@index([status])
  @@map("subscriptions")
}

model Entitlement {
  id          Int                @id @default(autoincrement())
  user_id     Int
  content_id  Int
  source      EntitlementSource
  granted_at  DateTime           @default(now())
  expires_at  DateTime?

  @@index([user_id])
  @@index([content_id])
  @@map("entitlements")
}

model Order {
  id                   Int          @id @default(autoincrement())
  user_id              Int
  content_id           Int?
  plan_id              Int?
  amount_ngn           Decimal?     @db.Decimal(12, 2)
  currency             String       @default("NGN") @db.VarChar(3)
  status               OrderStatus  @default(pending)
  order_type           OrderType    @default(direct)
  invoice_requested    Boolean      @default(false)
  invoice_url          String?      @db.VarChar(500)
  invoice_number       String?      @db.VarChar(40)
  invoice_due_date     DateTime?    @db.Date
  coupon_id            Int?
  paystack_reference   String?      @db.VarChar(120)
  created_at           DateTime     @default(now())

  @@index([user_id])
  @@index([status])
  @@index([paystack_reference])
  @@index([order_type])
  @@map("orders")
}

model Coupon {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique @db.VarChar(40)
  discount_type      CouponDiscountType?
  discount_value     Decimal?            @db.Decimal(10, 2)
  applies_to         CouponAppliesTo?
  target_id          Int?
  max_redemptions    Int?
  redemption_count   Int                 @default(0)
  valid_from         DateTime?
  valid_until        DateTime?
  min_order_ngn      Decimal?            @db.Decimal(10, 2)
  is_active          Boolean             @default(true)
  created_by         Int?

  @@map("coupons")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INSTRUCTORS & PAYOUTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model InstructorApplication {
  id                 Int                          @id @default(autoincrement())
  full_name          String?                      @db.VarChar(150)
  email              String?                      @db.VarChar(190)
  phone              String?                      @db.VarChar(30)
  expertise_areas    String?                      @db.VarChar(300)
  proposed_topics    String?                      @db.Text
  linkedin_url       String?                      @db.VarChar(300)
  sample_video_url   String?                      @db.VarChar(500)
  audience_size      String?                      @db.VarChar(60)
  status             InstructorApplicationStatus  @default(pending)
  reviewer_id        Int?
  reviewed_at        DateTime?
  rejection_reason   String?                      @db.Text
  created_at         DateTime                     @default(now())

  @@map("instructor_applications")
}

model ReviewQueueItem {
  id            Int             @id @default(autoincrement())
  content_id    Int?
  submitted_by  Int?
  submitted_at  DateTime        @default(now())
  reviewer_id   Int?
  reviewed_at   DateTime?
  decision      ReviewDecision  @default(pending)
  notes         String?         @db.Text

  @@map("review_queue")
}

model EarningLine {
  id                   Int                @id @default(autoincrement())
  speaker_id           Int
  content_id           Int
  order_id             Int?
  subscription_id      Int?
  period_month         String?            @db.VarChar(7)
  gross_ngn            Decimal?           @db.Decimal(14, 2)
  share_pct            Decimal?           @db.Decimal(5, 2)
  earned_ngn           Decimal?           @db.Decimal(14, 2)
  attribution_basis    AttributionBasis?
  watch_hours          Decimal?           @db.Decimal(10, 2)
  holdback_until       DateTime?
  status               EarningStatus      @default(accruing)
  created_at           DateTime           @default(now())

  @@index([speaker_id])
  @@index([period_month])
  @@index([status])
  @@map("earning_lines")
}

model PayoutRun {
  id               Int              @id @default(autoincrement())
  period_month     String?          @db.VarChar(7)
  status           PayoutRunStatus  @default(draft)
  total_gross_ngn  Decimal?         @db.Decimal(14, 2)
  total_wht_ngn    Decimal?         @db.Decimal(14, 2)
  total_net_ngn    Decimal?         @db.Decimal(14, 2)
  approved_by      Int?
  approved_at      DateTime?
  completed_at     DateTime?

  @@map("payout_runs")
}

/// NOTE: rows are APPEND-ONLY once status = 'paid'. Enforce in the service layer.
model PayoutLine {
  id                Int                @id @default(autoincrement())
  payout_run_id     Int
  speaker_id        Int
  gross_ngn         Decimal?           @db.Decimal(14, 2)
  commission_ngn    Decimal?           @db.Decimal(14, 2)
  wht_applicable    Boolean            @default(false)
  wht_rate          Decimal            @default(0) @db.Decimal(5, 2)
  wht_amount_ngn    Decimal            @default(0) @db.Decimal(14, 2)
  net_ngn           Decimal?           @db.Decimal(14, 2)
  payment_reference String?            @db.VarChar(120)
  status            PayoutLineStatus   @default(pending)
  paid_at           DateTime?
  failure_reason    String?            @db.VarChar(300)
  statement_url     String?            @db.VarChar(500)

  @@index([payout_run_id])
  @@index([speaker_id])
  @@index([status])
  @@map("payout_lines")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ANALYTICS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model StreamSession {
  id                     Int                    @id @default(autoincrement())
  content_id             Int?
  stream_key_used        String?                @db.VarChar(255)
  status                 StreamSessionStatus?
  started_at             DateTime?
  ended_at               DateTime?
  duration_seconds       Int?
  peak_viewers           Int                    @default(0)
  peak_at                DateTime?
  avg_viewers            Int                    @default(0)
  reconnect_count        Int                    @default(0)
  avg_bitrate_kbps       Int?
  dropped_frames         Int?
  failure_reason         String?                @db.VarChar(300)
  incident_notified_at   DateTime?

  @@index([content_id])
  @@index([status])
  @@index([started_at])
  @@map("stream_sessions")
}

model StreamHealthSample {
  id                   Int      @id @default(autoincrement())
  stream_session_id    Int
  sampled_at           DateTime @default(now())
  bitrate_kbps         Int?
  framerate            Int?
  dropped_frames       Int?
  concurrent_viewers   Int?

  @@index([stream_session_id, sampled_at])
  @@map("stream_health_samples")
}

model PlaybackSession {
  id                   Int          @id @default(autoincrement())
  user_id              Int?
  content_id           Int?
  lesson_id            Int?
  started_at           DateTime     @default(now())
  ended_at             DateTime?
  watch_seconds        Int          @default(0)
  completion_pct       Decimal      @default(0) @db.Decimal(5, 2)
  device_type          DeviceType?
  os                   String?      @db.VarChar(60)
  browser              String?      @db.VarChar(60)
  country              String?      @db.VarChar(2)
  region               String?      @db.VarChar(80)
  network_type         String?      @db.VarChar(20)
  avg_bitrate_kbps     Int?
  load_time_ms         Int?
  buffering_events     Int          @default(0)
  buffering_seconds    Int          @default(0)
  quality_changes      Int          @default(0)
  error_code           String?      @db.VarChar(60)
  playback_speed       Decimal      @default(1.0) @db.Decimal(3, 2)

  @@index([content_id])
  @@index([user_id])
  @@index([started_at])
  @@index([region])
  @@index([device_type])
  @@map("playback_sessions")
}

model UsageDaily {
  id                 Int       @id @default(autoincrement())
  date               DateTime  @unique @db.Date
  storage_gb         Decimal   @default(0) @db.Decimal(12, 3)
  bandwidth_gb       Decimal   @default(0) @db.Decimal(12, 3)
  transcode_minutes  Int       @default(0)
  cost_usd           Decimal   @default(0) @db.Decimal(12, 2)
  fx_rate_ngn        Decimal?  @db.Decimal(12, 2)
  cost_ngn           Decimal   @default(0) @db.Decimal(14, 2)

  @@map("usage_daily")
}

model ContentUsage {
  id                    Int      @id @default(autoincrement())
  content_id            Int
  period_month          String   @db.VarChar(7)
  views                 Int      @default(0)
  watch_hours           Decimal  @default(0) @db.Decimal(12, 2)
  bandwidth_gb          Decimal  @default(0) @db.Decimal(12, 3)
  estimated_cost_ngn    Decimal  @default(0) @db.Decimal(14, 2)
  revenue_ngn           Decimal  @default(0) @db.Decimal(14, 2)
  margin_ngn            Decimal  @default(0) @db.Decimal(14, 2)

  @@unique([content_id, period_month])
  @@map("content_usage")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRANSCRIPTS & CHAPTERS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Transcript {
  id             Int               @id @default(autoincrement())
  content_id     Int?
  media_asset_id Int?
  language       String            @default("en") @db.VarChar(10)
  full_text      String?           @db.Text
  word_count     Int?
  status         TranscriptStatus  @default(pending)
  provider       String?           @db.VarChar(50)
  generated_at   DateTime?
  edited_by      Int?
  edited_at      DateTime?

  @@map("transcripts")
}

model TranscriptSegment {
  id             Int      @id @default(autoincrement())
  transcript_id  Int
  start_seconds  Decimal? @db.Decimal(10, 2)
  end_seconds    Decimal? @db.Decimal(10, 2)
  speaker_label  String?  @db.VarChar(80)
  text           String?  @db.Text

  @@index([transcript_id, start_seconds])
  @@map("transcript_segments")
}

model Chapter {
  id               Int          @id @default(autoincrement())
  content_id       Int
  title            String?      @db.VarChar(200)
  title_fr         String?      @db.VarChar(200)
  start_seconds    Int?
  chapter_type     ChapterType?
  is_skippable     Boolean      @default(false)
  display_order    Int?
  auto_generated   Boolean      @default(true)
  edited_by        Int?

  @@index([content_id, start_seconds])
  @@map("chapters")
}

model SubtitleTrack {
  id              Int             @id @default(autoincrement())
  content_id      Int?
  media_asset_id  Int?
  language        String?         @db.VarChar(10)
  label           String?         @db.VarChar(60)
  vtt_url         String?         @db.VarChar(500)
  source          SubtitleSource?
  is_default      Boolean         @default(false)
  is_reviewed     Boolean         @default(false)

  @@index([content_id])
  @@map("subtitle_tracks")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMMUNITY
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model CommunitySpace {
  id                 Int                 @id @default(autoincrement())
  name               String?             @db.VarChar(150)
  slug               String              @unique @db.VarChar(170)
  description        String?             @db.Text
  space_type         CommunitySpaceType  @default(open)
  linked_content_id  Int?
  is_active          Boolean             @default(true)
  created_at         DateTime            @default(now())

  @@map("community_spaces")
}

model SpaceMember {
  id        Int              @id @default(autoincrement())
  space_id  Int
  user_id   Int
  role      SpaceMemberRole  @default(member)
  joined_at DateTime         @default(now())

  @@unique([space_id, user_id])
  @@map("space_members")
}

model SpacePost {
  id              Int      @id @default(autoincrement())
  space_id        Int
  user_id         Int
  body            String?  @db.Text
  attachment_url  String?  @db.VarChar(500)
  is_pinned       Boolean  @default(false)
  created_at      DateTime @default(now())

  @@index([space_id, created_at])
  @@map("space_posts")
}

model PostComment {
  id         Int      @id @default(autoincrement())
  post_id    Int
  user_id    Int
  body       String?  @db.Text
  created_at DateTime @default(now())

  @@index([post_id])
  @@map("post_comments")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RATINGS, CERTIFICATES & RESOURCES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Rating {
  id          Int      @id @default(autoincrement())
  user_id     Int
  content_id  Int
  score       Int
  comment     String?  @db.Text
  created_at  DateTime @default(now())

  @@unique([user_id, content_id])
  @@index([content_id])
  @@map("ratings")
}

model Certificate {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  content_id         Int
  issued_at          DateTime @default(now())
  verification_code  String   @unique @default(uuid()) @db.VarChar(40)
  pdf_url            String?  @db.VarChar(500)

  @@index([user_id])
  @@index([verification_code])
  @@map("certificates")
}

model Resource {
  id                    Int      @id @default(autoincrement())
  content_id            Int?
  lesson_id             Int?
  title                 String?  @db.VarChar(200)
  file_url              String?  @db.VarChar(500)
  file_type             String?  @db.VarChar(20)
  file_size_kb          Int?
  requires_entitlement  Boolean  @default(true)
  created_at            DateTime @default(now())

  @@index([content_id])
  @@index([lesson_id])
  @@map("resources")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
