  setting_value  String?   @db.Text
  setting_group  String?   @db.VarChar(50)
  is_secret      Boolean   @default(false)
  updated_at     DateTime  @updatedAt
  updated_by     Int?

  @@index([setting_group])
  @@map("settings")
}

model AppModule {
